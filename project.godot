; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Lockdown Heist: Bandit"
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.0392157, 0.0705882, 0.133333, 1)
boot_splash/image="res://assets/store/android/splash_card.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
config/icon="res://assets/store/android/icon_512.png"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Events="*res://scripts/autoload/events.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
JuiceManager="*res://scripts/systems/juice_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=5
window/immersive=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
environment/defaults/default_clear_color=Color(0.04, 0.08, 0.14, 1)
textures/vram_compression/import_etc2_astc=true
